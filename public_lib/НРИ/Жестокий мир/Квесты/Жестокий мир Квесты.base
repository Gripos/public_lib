views:
  - type: table
    name: Таблица
    filters:
      and:
        - Кампейн == "Жестокий мир"
    groupBy:
      property: Выполнено
      direction: ASC
    order:
      - file.name
      - Выполнено
    sort:
      - property: file.name
        direction: DESC
      - property: Выполнено
        direction: ASC
    columnSize:
      file.name: 449
